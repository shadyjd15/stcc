# ─────────────────────────────────────────────────────────────────────────────
# STCC website – environment
# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# Most day-to-day settings (SMTP, inboxes, Cloudflare, Turnstile, analytics) are
# managed in the CMS under Settings – these are only the server-level values.
# ─────────────────────────────────────────────────────────────────────────────

# Public address of the site, no trailing slash
NEXT_PUBLIC_SERVER_URL=https://stcc.sa

# Database (docker-compose builds DATABASE_URL from these)
POSTGRES_DB=stcc
POSTGRES_USER=stcc
POSTGRES_PASSWORD=change-me
# When not using docker-compose (e.g. Hostinger + Neon/Supabase):
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=verify-full
# TLS for hosted databases whose certificate isn't publicly trusted (Supabase): remove sslmode
# from the URL, set DATABASE_SSL=require and paste the provider's CA certificate (PEM) below,
# or use DATABASE_SSL=no-verify. Leave empty for a local database or Neon.
DATABASE_SSL=
DATABASE_CA_CERT=
# Max database connections per app instance (5 is right for shared hosting / free tiers)
DATABASE_POOL_MAX=10

# Signs logins and sessions. Keep it secret; changing it signs everyone out.
PAYLOAD_SECRET=
# Encrypts vendor IBANs and stored API keys/passwords. Back it up – data encrypted
# with a lost key cannot be recovered. Defaults to PAYLOAD_SECRET if empty.
ENCRYPTION_KEY=
# Protects draft previews and the external cron endpoint
PREVIEW_SECRET=
CRON_SECRET=

# First start on an empty database loads all website content and creates this admin.
# Remove the password from .env after the first login.
SEED_ADMIN_EMAIL=admin@stcc.sa
SEED_ADMIN_PASSWORD=

# Fallback email sender (the CMS → Email & notifications settings override these)
SMTP_FROM=no-reply@stcc.sa
SMTP_FROM_NAME=STCC

# Cloudflare Turnstile site key (public). The secret key is entered in the CMS.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Tunnel (only with: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# File storage in Cloudflare R2 instead of the server's disk – required on Hostinger web hosting,
# optional with Docker. Two buckets, one API token:
#   R2_BUCKET          public bucket for images and brochures, served from R2_PUBLIC_URL (e.g. https://media.stcc.sa)
#   R2_PRIVATE_BUCKET  private bucket for CVs, vendor documents and form attachments (never make it public)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=

# Optional: AI second opinion on job applicants (Careers settings → AI assessment)
ANTHROPIC_API_KEY=

# Host port for the app container
APP_PORT=3000

# Bind address for `pnpm start` / server.mjs (default: all interfaces). Docker sets its own.
BIND_HOST=
